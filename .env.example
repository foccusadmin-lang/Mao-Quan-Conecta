# Copie para .env (local) ou cadastre nas variáveis de ambiente da hospedagem (Vercel/Netlify)

# Login Google real — Google Cloud Console › APIs e serviços › Credenciais › ID do cliente OAuth (Aplicativo da Web)
# Origens JavaScript autorizadas: https://maoquanconecta.com.br e https://www.maoquanconecta.com.br
VITE_GOOGLE_CLIENT_ID=

# Endereço público usado nos QR Codes e links de patrocinador (padrão em produção: https://maoquanconecta.com.br)
VITE_APP_URL=https://maoquanconecta.com.br
